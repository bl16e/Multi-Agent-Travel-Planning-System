QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AMAP_API_KEY=
SERPAPI_API_KEY=
# Bocha is used by the local MCP search_google_web tool for general web search.
BOCHA_API_KEY=
# Optional: set to a pre-started SerpAPI MCP endpoint, for example http://127.0.0.1:8765/mcp.
# Leave empty to let the agent auto-start mcp_servers/serpapi_server.py over stdio.
SERPAPI_MCP_URL=
# RollingGo MCP — real-time hotel and flight booking data for domestic Chinese travel.
# Get your key from https://rollinggo.store
ROLLINGGO_MCP_KEY=
ROLLINGGO_MCP_HOTEL_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_MCP_FLIGHT_URL=https://mcp.rollinggo.cn/mcp/flight
OUTPUT_DIR=artifacts
SESSION_STORE_DIR=artifacts/sessions
LANGGRAPH_CHECKPOINT_DB=artifacts/langgraph_checkpoints.sqlite
SESSION_CACHE_MAX_ENTRIES=500
SESSION_CACHE_TTL_SECONDS=86400
ENABLE_LANGGRAPH_INTERRUPTS=0
QWEN_TIMEOUT_SECONDS=60
PLAN_REQUEST_TIMEOUT_SECONDS=300
MCP_TOOLING_TIMEOUT_SECONDS=30
LIUBU_TOOL_TIMEOUT_SECONDS=30
RUN_LIVE_TESTS=0
